<Project Sdk="RaptorRush135.PvZR.Sdk">

  <PropertyGroup>
    <IsModBuild>true</IsModBuild>
    <ModMelonType>$(RootNamespace).Core.Core</ModMelonType>
    <ModColor>255, 0, 200, 0</ModColor>
  </PropertyGroup>

  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>dev</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <Target Name="EnableZipVersionDotReplacementForStableRelease" AfterTargets="MinVer" Condition="'$(MinVerPreRelease)' == ''">
    <PropertyGroup>
      <ModZipReplaceVersionDots>true</ModZipReplaceVersionDots>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <None Remove="Resources\icon.png" />
    <None Remove="Resources\lol.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\icon.png" />
    <EmbeddedResource Include="Resources\lol.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BloomEngine">
      <HintPath>D:\SteamLibrary\steamapps\common\PVZ Replanted\Mods\BloomEngine.dll</HintPath>
    </Reference>
    <Reference Include="ReplantAPI">
      <HintPath>D:\SteamLibrary\steamapps\common\PVZ Replanted\Mods\ReplantAPI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
